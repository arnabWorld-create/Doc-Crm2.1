# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database"
DIRECT_URL="postgresql://user:password@host:port/database"

# Supabase Configuration (for file uploads)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_BUCKET="patient-reports"
# Service role key is needed SERVER-SIDE for logo uploads (never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication (CRITICAL: Generate a strong secret)
JWT_SECRET="CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET-IN-PRODUCTION"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Redis Rate Limiting (RECOMMENDED for production)
# Sign up at https://upstash.com for free Redis
# Without these, falls back to in-memory rate limiting (resets on deploy)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Logging (optional - for external services)
# SENTRY_DSN="https://your-sentry-dsn"
# LOG_LEVEL="info"

# Cron Job Security (REQUIRED for analytics pre-calculation)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="your-cron-secret-here"

# Optional: Gemini API (if using AI features)
GEMINI_API_KEY="your-gemini-api-key"

# SECURITY NOTES:
# 1. NEVER commit .env.local to git
# 2. Generate JWT_SECRET using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Use different secrets for development and production
# 4. Rotate secrets regularly
# 5. For production, set up Upstash Redis for persistent rate limiting
